<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_payslip_wizard_form" model="ir.ui.view">
        <field name="name">hr.payroll.payslip.wizard.form</field>
        <field name="model">hr.payroll.payslip.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimir Boletas de Pago">
                <group>
                    <field name="payroll_id" invisible="1"/>
                    <field name="print_mode" widget="radio"/>
                    <field name="download_format" widget="radio" invisible="print_mode != 'all'"/>
                    <field name="eligible_employee_ids" invisible="1"/>
                    <field name="employee_id" invisible="print_mode != 'employee'" required="print_mode == 'employee'"
                           domain="[('id', 'in', eligible_employee_ids)]" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_print" string="Descargar boletas" type="object" class="btn-primary" icon="fa-download"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_payroll_payslip_wizard" model="ir.actions.act_window">
        <field name="name">Imprimir Boletas de Pago</field>
        <field name="res_model">hr.payroll.payslip.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_payroll"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
