<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_payroll_payment_fiscal_wizard" model="ir.ui.view">
        <field name="name">hr.payroll.payment.fiscal.wizard.form</field>
        <field name="model">hr.payroll.payment.fiscal.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar pago y fecha fiscal">
                <group>
                    <field name="payroll_id" readonly="1" force_save="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="total_due"/>
                    <field name="company_id" invisible="1"/>
                    <field name="pending_amount"/>
                    <field name="fiscal_date" required="not register_payment or payment_result == 'paid'"/>
                    <field name="register_payment"/>
                </group>
                <group invisible="not register_payment">
                    <field name="payment_result"/>
                    <field name="bank_line_id" invisible="payment_result != 'paid'" required="register_payment and payment_result == 'paid'"
                           domain="[('company_id', '=', company_id), ('amount', '&lt;', 0)]" options="{'no_create': True}"/>
                    <field name="rejection_reason" invisible="payment_result != 'rejected'" required="register_payment and payment_result == 'rejected'"/>
                    <field name="payment_date" required="register_payment"/>
                    <field name="amount" required="register_payment"/>
                    <field name="reference" required="register_payment"/>
                    <field name="proof_name" invisible="1"/>
                    <field name="proof" filename="proof_name" required="register_payment"/>
                </group>
                <footer>
                    <button name="action_register" type="object" class="btn-primary" string="Registrar"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_hr_payroll_filing_wizard" model="ir.ui.view">
        <field name="name">hr.payroll.filing.wizard.form</field>
        <field name="model">hr.payroll.filing.wizard</field>
        <field name="arch" type="xml">
            <form string="Declaraciones y control fiscal">
                <group>
                    <field name="company_id"/>
                    <field name="report_type"/>
                    <field name="period"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <group invisible="report_type not in ('f14_csv', 'f910_csv')">
                    <field name="fiscal_domestic_confirmed" required="report_type in ('f14_csv', 'f910_csv')"/>
                    <field name="f14_classification" invisible="report_type != 'f14_csv'" required="report_type == 'f14_csv'"/>
                </group>
                <group invisible="report_type != 'recalc'">
                    <field name="employee_id" domain="[('company_id', '=', company_id)]"/>
                    <field name="prior_employer_base" invisible="not employee_id"/>
                    <field name="prior_employer_withholding" invisible="not employee_id"/>
                    <field name="prior_reference" invisible="not employee_id"/>
                </group>
                <field name="special_isr_ids" invisible="report_type != 'recalc'">
                    <list editable="bottom">
                        <field name="currency_id" column_invisible="1"/>
                        <field name="payroll_line_id" options="{'no_create': True}"/>
                        <field name="taxable_net"/>
                        <field name="withholding"/>
                        <field name="reference"/>
                    </list>
                </field>
                <footer>
                    <button name="action_download" type="object" class="btn-primary" string="Descargar CSV"/>
                    <button special="cancel" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_hr_payroll_filing_wizard" model="ir.actions.act_window">
        <field name="name">Declaraciones y control fiscal</field>
        <field name="res_model">hr.payroll.filing.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
