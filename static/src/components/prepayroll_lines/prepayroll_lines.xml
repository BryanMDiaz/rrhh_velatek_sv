<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rrhh_velatek_sv.PrepayrollLines.Rows" t-inherit="web.ListRenderer.Rows" t-inherit-mode="primary">
        <xpath expr="//t[@t-foreach='list.records']" position="replace">
            <t t-foreach="departmentGroups" t-as="department" t-key="department.id">
                <tr class="o_group_header o_prepayroll_department">
                    <td t-att-colspan="nbCols">
                        <span class="o_prepayroll_department_label"><t t-esc="department.label"/></span>
                    </td>
                </tr>
                <t t-foreach="department.records" t-as="record" t-key="record.id">
                    <t t-call="{{ constructor.recordRowTemplate }}"/>
                </t>
            </t>
        </xpath>
    </t>
</templates>
