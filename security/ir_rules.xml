        <!-- ═══════════════════════════════════════════════════════════════
             REGLAS DE SEGURIDAD PARA INFORMACIÓN SENSIBLE DE RRHH
             Autoservicio para Empleados (solo ven sus propios datos)
             Acceso total para RRHH (filtrado por compañía)
        ═══════════════════════════════════════════════════════════════ -->

        <!-- hr.employee.beneficiary: Empleado solo ve sus propios beneficiarios -->
        <record id="hr_employee_beneficiary_rule_employee" model="ir.rule">
            <field name="name">Beneficiarios: empleado ve solo sus propios beneficiarios</field>
            <field name="model_id" ref="model_hr_employee_beneficiary"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- hr.employee.beneficiary: RRHH ve beneficiarios de su compañía -->
        <record id="hr_employee_beneficiary_rule_hr" model="ir.rule">
            <field name="name">Beneficiarios: RRHH ve todos en sus compañías</field>
            <field name="model_id" ref="model_hr_employee_beneficiary"/>
            <field name="domain_force">['|', ('employee_id.company_id', '=', False), ('employee_id.company_id', 'in', company_ids)]</field>
