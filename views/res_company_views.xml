<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_view_form_velatek" model="ir.ui.view">
        <field name="name">res.company.form.velatek</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Representante Legal (Velatek)" name="velatek_legal_rep">
                    <group>
                        <field name="velatek_legal_representative_id" context="{'default_is_company': False}"/>
                        <field name="velatek_work_week_start"/>
                        <field name="sv_spu_employer_number"/>
                        <field name="velatek_minimum_wage_sector"/>
                        <field name="velatek_minimum_wage_from"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="hr_work_location_form_minimum_wage" model="ir.ui.view">
        <field name="name">hr.work.location.form.minimum.wage</field>
        <field name="model">hr.work.location</field>
        <field name="inherit_id" ref="hr.hr_work_location_form_view"/>
        <field name="arch" type="xml">
            <field name="address_id" position="after">
                <field name="velatek_minimum_wage_sector"/>
                <field name="sv_spu_work_center"/>
            </field>
        </field>
    </record>

    <!-- Adding partner fields to base partner view -->
    <record id="view_partner_form_velatek_rep" model="ir.ui.view">
        <field name="name">res.partner.form.velatek.rep</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Datos Legales (Velatek)" name="velatek_legal_data">
                    <group>
                        <field name="velatek_dui"/>
                        <field name="velatek_profession"/>
                        <field name="velatek_birth_date"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
