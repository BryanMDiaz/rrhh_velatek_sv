<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_generated_document_view_form" model="ir.ui.view">
        <field name="name">hr.contract.generated.document.form</field>
        <field name="model">hr.contract.generated.document</field>
        <field name="arch" type="xml">
            <form string="Documento Generado">
                <header>
                    <button name="action_mark_signed" type="object" string="Marcar como Firmado" class="oe_highlight" invisible="state in ('signed', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state in ('signed', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <field name="contract_company_id" invisible="1"/>
                        <group>
                            <field name="contract_id" readonly="state != 'draft'"/>
                            <field name="employee_id"/>
                            <field name="template_id" readonly="1"/>
                            <field name="template_version" readonly="1"/>
                        </group>
                        <group>
                            <field name="generated_date" readonly="1"/>
                            <field name="generated_by_id" readonly="1"/>
                            <field name="pdf_attachment_id" readonly="1"/>
                            <field name="signature_date" readonly="state == 'signed' and signature_date"/>
                            <field name="signed_attachment_ids" widget="many2many_binary" invisible="state == 'cancelled'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contenido Final (Snapshot)" name="snapshot">
                            <field name="content_snapshot" widget="html" readonly="1" options="{'style-inline': true}"/>
                        </page>
                        <page string="Presentación al MTPS" name="mtps_filing" invisible="mtps_status == 'not_required'">
                            <group>
                                <group>
                                    <field name="mtps_document_type"/>
                                    <field name="mtps_status"/>
                                    <field name="mtps_due_date" help="Recordatorio a ocho días calendario de la firma, conforme al plazo de referencia del artículo 18."/>
                                    <field name="mtps_responsible_id" domain="[('company_ids', 'in', [contract_company_id])]"/>
                                </group>
                                <group>
                                    <field name="mtps_submitted_date" readonly="state != 'signed'"/>
                                    <field name="mtps_reference" readonly="state != 'signed'"/>
                                    <field name="mtps_ack_date" readonly="state != 'signed'"/>
                                    <field name="mtps_ack_filename" invisible="1"/>
                                    <field name="mtps_ack_file" filename="mtps_ack_filename" readonly="state != 'signed'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_contract_generated_document_view_tree" model="ir.ui.view">
        <field name="name">hr.contract.generated.document.tree</field>
        <field name="model">hr.contract.generated.document</field>
        <field name="arch" type="xml">
            <list string="Documentos Generados">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="generated_date"/>
                <field name="mtps_status" optional="show"/>
                <field name="mtps_due_date" optional="show"/>
                <field name="mtps_responsible_id" optional="hide"/>
                <field name="mtps_submitted_date" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'signed'" decoration-info="state == 'generated'" decoration-warning="state == 'pending_signature'" decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>
    <record id="hr_contract_generated_document_search_mtps" model="ir.ui.view">
        <field name="name">hr.contract.generated.document.search.mtps</field>
        <field name="model">hr.contract.generated.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="contract_id"/>
                <field name="mtps_responsible_id"/>
                <filter name="mtps_open" string="Pendientes de gestión" domain="[('mtps_status', 'in', ('pending', 'submitted')), ('state', '=', 'signed')]"/>
                <filter name="mtps_pending" string="Pendientes de presentar" domain="[('mtps_status', '=', 'pending')]"/>
                <filter name="mtps_overdue" string="Plazo de presentación vencido" domain="[('mtps_status', '=', 'pending'), ('mtps_due_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="mtps_missing_signature_date" string="Firmados sin fecha de firma" domain="[('mtps_status', '=', 'waiting_signature'), ('state', '=', 'signed')]"/>
                <filter name="mtps_submitted" string="Pendientes de acuse" domain="[('mtps_status', '=', 'submitted')]"/>
            </search>
        </field>
    </record>
    <record id="action_hr_contract_mtps_tracking" model="ir.actions.act_window">
        <field name="name">Presentación de contratos al MTPS</field>
        <field name="res_model">hr.contract.generated.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_contract_generated_document_search_mtps"/>
        <field name="domain">[('mtps_status', '!=', 'not_required')]</field>
        <field name="context">{'search_default_mtps_open': 1}</field>
    </record>
</odoo>
