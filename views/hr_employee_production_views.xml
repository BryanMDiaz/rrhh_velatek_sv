<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista Formulario de Producción -->
        <record id="hr_employee_production_view_form" model="ir.ui.view">
            <field name="name">hr.employee.production.form</field>
            <field name="model">hr.employee.production</field>
            <field name="arch" type="xml">
                <form string="Producción del Empleado">
                    <header>
                        <button name="action_submit" groups="hr.group_hr_user" string="Enviar a Aprobar" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_approve" groups="rrhh_velatek_sv.group_hr_responsible" string="Aprobar" type="object" class="oe_highlight" invisible="state != 'to_approve'"/>
                        <button name="action_draft" groups="hr.group_hr_manager" string="Volver a Borrador" type="object" invisible="state in ('draft', 'processed')"/>
                        <button name="action_cancel" groups="hr.group_hr_manager" string="Cancelar" type="object" invisible="state in ('processed', 'cancelled')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,approved,processed"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id" domain="[('contract_ids.state', '=', 'open'), ('contract_ids.velatek_remuneration_mode', 'in', ['production', 'mixed'])]"/>
                                <field name="contract_id" domain="[('employee_id', '=', employee_id), ('state', '=', 'open')]"/>
                                <field name="project_id"/>
                                <field name="date"/>
                            </group>
                            <group>
                                <field name="quantity"/>
                                <field name="unit"/>
                                <field name="rate"/>
                                <field name="amount"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notas">
                                <field name="notes" placeholder="Agregue notas o detalles sobre el trabajo..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista Lista (Tree) de Producción -->
        <record id="hr_employee_production_view_tree" model="ir.ui.view">
            <field name="name">hr.employee.production.tree</field>
            <field name="model">hr.employee.production</field>
            <field name="arch" type="xml">
                <list string="Producción" decoration-info="state == 'draft'" decoration-success="state == 'processed'" decoration-warning="state == 'to_approve'" decoration-muted="state == 'cancelled'">
                    <field name="date"/>
                    <field name="employee_id"/>
                    <field name="contract_id"/>
                    <field name="project_id"/>
                    <field name="quantity"/>
                    <field name="unit"/>
                    <field name="rate"/>
                    <field name="amount" sum="Total"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Filtros y Búsqueda -->
        <record id="hr_employee_production_view_search" model="ir.ui.view">
            <field name="name">hr.employee.production.search</field>
            <field name="model">hr.employee.production</field>
            <field name="arch" type="xml">
                <search string="Producción">
                    <field name="employee_id"/>
                    <field name="project_id"/>
                    <field name="date"/>
                    <filter string="Por Aprobar" name="to_approve" domain="[('state', '=', 'to_approve')]"/>
                    <filter string="Aprobado" name="approved" domain="[('state', '=', 'approved')]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Empleado" name="group_employee" context="{'group_by':'employee_id'}"/>
                        <filter string="Proyecto" name="group_project" context="{'group_by':'project_id'}"/>
                        <filter string="Estado" name="group_state" context="{'group_by':'state'}"/>
                        <filter string="Mes" name="group_month" context="{'group_by':'date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Acción de Producción -->
        <record id="action_hr_employee_production" model="ir.actions.act_window">
            <field name="name">Producción</field>
            <field name="res_model">hr.employee.production</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="hr_employee_production_view_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Registrar producción de empleados
                </p>
                <p>
                    Lleve el control del trabajo realizado por proyectos para su posterior pago.
                </p>
            </field>
        </record>
    </data>
</odoo>
