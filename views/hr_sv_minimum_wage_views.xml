<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hr_sv_minimum_wage_list" model="ir.ui.view">
        <field name="name">hr.sv.minimum.wage.list</field>
        <field name="model">hr.sv.minimum.wage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="sector"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="monthly_amount"/>
                <field name="daily_amount"/>
                <field name="hourly_amount"/>
                <field name="legal_reference"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="action_hr_sv_minimum_wage" model="ir.actions.act_window">
        <field name="name">Salario mínimo de El Salvador</field>
        <field name="res_model">hr.sv.minimum.wage</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
