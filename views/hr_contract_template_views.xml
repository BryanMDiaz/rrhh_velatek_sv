<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_template_view_form" model="ir.ui.view">
        <field name="name">hr.contract.template.form</field>
        <field name="model">hr.contract.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de Contrato">
                <header>
                    <button name="action_preview_template" string="Vista previa" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Ej. Servicios Profesionales 2026"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="contract_type_id"/>
                            <field name="is_default"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="version"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contenido (HTML)" name="body">
                            <field name="body_html" widget="html" options="{'style-inline': true}"/>
                        </page>
                        <page string="Descripción y Notas" name="notes">
                            <group>
                                <field name="description"/>
                                <field name="notes"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_contract_template_view_tree" model="ir.ui.view">
        <field name="name">hr.contract.template.tree</field>
        <field name="model">hr.contract.template</field>
        <field name="arch" type="xml">
            <list string="Plantillas de Contrato">
                <field name="name"/>
                <field name="contract_type_id"/>
                <field name="version"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="is_default"/>
                <button name="action_preview_template" string="Vista previa" type="object"/>
            </list>
        </field>
    </record>

    <record id="action_hr_contract_template" model="ir.actions.act_window">
        <field name="name">Plantillas de Contrato</field>
        <field name="res_model">hr.contract.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera plantilla de contrato.
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_contract_template" 
              name="Plantillas de Contrato" 
              parent="hr_contract.menu_human_resources_configuration_contract" 
              action="action_hr_contract_template" 
              sequence="50"
              groups="hr_contract.group_hr_contract_manager"/>
</odoo>
