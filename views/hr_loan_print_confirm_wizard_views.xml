<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_loan_print_confirm_wizard_form" model="ir.ui.view">
        <field name="name">hr.loan.print.confirm.wizard.form</field>
        <field name="model">hr.loan.print.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar impresión de contrato">
                <field name="loan_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <field name="message" nolabel="1" readonly="1"/>
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Aceptar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
